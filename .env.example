APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

POSTGRES_DB=refiq
POSTGRES_USER=refiq
POSTGRES_PASSWORD=refiq_dev_password

DATABASE_URL=postgresql+asyncpg://refiq:refiq_dev_password@postgres:5432/refiq
REDIS_URL=redis://redis:6379/0

SESSION_COOKIE_NAME=refiq_session
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Internal admin console (admin.int.refiq.ru). Do not expose these services on the public internet.
ADMIN_HOST=admin.int.refiq.ru
ADMIN_FRONTEND_URL=http://localhost:3100
ADMIN_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:5174
ADMIN_SESSION_COOKIE_NAME=refiq_admin_session
ADMIN_SESSION_COOKIE_SECURE=false

# AI — keep provider keys only in secrets / environment, never in frontend or git.
# AI_PROVIDER remains the fallback when AI_TEXT_PROVIDER / AI_IMAGE_PROVIDER are empty.
AI_PROVIDER=openai
AI_TEXT_PROVIDER=openai
AI_IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PROMO_MODEL=gpt-5.6-luna
OPENAI_PROMO_REASONING_EFFORT=none
PROMO_GENERATION_CONCURRENCY=1
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45
AI_IMAGE_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=1
AI_GUIDANCE_MAX_CHARS=4000
OPENAI_GUARD_MODEL=gpt-4.1-mini
# AI_GUARD_MODEL=
AI_SEMANTIC_GUARD_ENABLED=true
AI_SEMANTIC_GUARD_FAIL_CLOSED=true
AI_OUTPUT_GROUNDING_ENABLED=true
AI_SEMANTIC_GROUNDING_ENABLED=false
# OPENAI_IMAGE_MODEL: gpt-image-1 / gpt-image-2 use /v1/images/generations.
# Chat models like gpt-5.4-luna / gpt-5.6-luna generate images via /v1/responses.
OPENAI_IMAGE_MODEL=gpt-image-1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROMO_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=60
# DEEPSEEK_MAX_RETRIES=1
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_AI_IMAGE_MODEL=aliceai-image-art-3.0
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net
YANDEX_AI_IMAGE_PROMPT_MAX_CHARS=500
# YANDEX_AI_IMAGE_TIMEOUT_SECONDS=90
ASSET_STORAGE_DIR=./data/assets

# Yandex Object Storage (S3-compatible). When access key and secret are set,
# files (creatives, QR codes) are stored in the existing bucket. Leave empty for local disk.
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=refiq-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public app URL for links in transactional emails (falls back to FRONTEND_URL).
APP_PUBLIC_URL=http://localhost:3000

# Yandex Cloud Postbox (Amazon-compatible API, not SMTP). Leave keys empty to disable sending.
YANDEX_POSTBOX_ACCESS_KEY_ID=
YANDEX_POSTBOX_SECRET_ACCESS_KEY=
YANDEX_POSTBOX_REGION=ru-central1
YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
EMAIL_FROM=no-reply@refiq.ru
EMAIL_FROM_NAME=RefIQ
