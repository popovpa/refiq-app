APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

POSTGRES_DB=refiq
POSTGRES_USER=refiq
POSTGRES_PASSWORD=refiq_dev_password

DATABASE_URL=postgresql+asyncpg://refiq:refiq_dev_password@postgres:5432/refiq
REDIS_URL=redis://redis:6379/0

SESSION_COOKIE_NAME=refiq_session
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Internal admin console (admin.int.refiq.ru). Do not expose these services on the public internet.
ADMIN_HOST=admin.int.refiq.ru
ADMIN_FRONTEND_URL=http://localhost:3100
ADMIN_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:5174
ADMIN_SESSION_COOKIE_NAME=refiq_admin_session
ADMIN_SESSION_COOKIE_SECURE=false

# AI — keep provider keys only in secrets / environment, never in frontend or git.
# AI_PROVIDER remains the fallback when AI_TEXT_PROVIDER / AI_IMAGE_PROVIDER are empty.
AI_PROVIDER=openai
AI_TEXT_PROVIDER=openai
AI_IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PROMO_MODEL=gpt-5.6-luna
OPENAI_PROMO_REASONING_EFFORT=none
PROMO_GENERATION_CONCURRENCY=1
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45
AI_IMAGE_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=1
AI_GUIDANCE_MAX_CHARS=4000
OPENAI_GUARD_MODEL=gpt-4.1-mini
# AI_GUARD_MODEL=
AI_SEMANTIC_GUARD_ENABLED=true
AI_SEMANTIC_GUARD_FAIL_CLOSED=true
AI_OUTPUT_GROUNDING_ENABLED=true
AI_SEMANTIC_GROUNDING_ENABLED=false
# OPENAI_IMAGE_MODEL: gpt-image-1 / gpt-image-2 use /v1/images/generations.
# Chat models like gpt-5.4-luna / gpt-5.6-luna generate images via /v1/responses.
OPENAI_IMAGE_MODEL=gpt-image-1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROMO_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=60
# DEEPSEEK_MAX_RETRIES=1
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_AI_IMAGE_MODEL=aliceai-image-art-3.0
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net
YANDEX_AI_IMAGE_PROMPT_MAX_CHARS=500
# YANDEX_AI_IMAGE_TIMEOUT_SECONDS=90
ASSET_STORAGE_DIR=./data/assets

# Yandex Object Storage (S3-compatible). When access key and secret are set,
# files (creatives, QR codes) are stored in the existing bucket. Leave empty for local disk.
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=refiq-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public app URL for links in transactional emails (falls back to FRONTEND_URL).
APP_PUBLIC_URL=http://localhost:3000

# Mail commands. The API encrypts the payload and writes outbox_event.
# Generate a 32-byte key: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MAIL_KAFKA_TOPIC=mail-events
MAIL_EVENT_ENCRYPTION_KEY=
MAIL_EVENT_ENCRYPTION_KEY_VERSION=v1
# Admin overview probes the internal mail process. Empty means "not configured".
MAIL_SERVICE_URL=

# Mail service. Same physical Postgres is allowed; mail owns its own tables and Alembic history.
MAIL_DATABASE_URL=postgresql+asyncpg://refiq:refiq_dev_password@localhost:5432/refiq
MAIL_KAFKA_DLQ_TOPIC=mail-events.dlq
MAIL_KAFKA_GROUP_ID=mail-service
MAIL_WORKER_BATCH_SIZE=10
MAIL_WORKER_POLL_INTERVAL=2
MAIL_PROCESSING_LEASE_SECONDS=60

# Yandex Cloud Postbox is used only by the mail service (not by the API).
EMAIL_FROM=no-reply@refiq.ru
EMAIL_FROM_NAME=RefIQ
EMAIL_SEND_TIMEOUT_SECONDS=8
YANDEX_POSTBOX_ACCESS_KEY_ID=
YANDEX_POSTBOX_SECRET_ACCESS_KEY=
YANDEX_POSTBOX_REGION=ru-central1
YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
FINANCIAL_TRANSACTIONS_ENABLED=false
FINANCIAL_PROVIDER=TBANK
PAYOUT_MIN_AMOUNT=500.00
PAYOUT_INTERVAL_DAYS=14
PAYOUT_DUE_DAYS=3
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=30
PLAN_PRO_AMOUNT=4990.00

# T-Bank Internet Acquiring (Business → RefIQ). Leave empty in local/test.
# Live payments also require FINANCIAL_TRANSACTIONS_ENABLED=true.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_E2C_TERMINAL_KEY=
TBANK_E2C_PASSWORD=
TBANK_ACQUIRING_BASE_URL=https://securepay.tinkoff.ru/v2
TBANK_E2C_BASE_URL=https://securepay.tinkoff.ru/e2c/v2
TBANK_NOTIFICATION_URL=

# Kafka. From the host use localhost:9092. Inside compose the API uses kafka:19092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=refiq-api

# Transactional outbox for audit events. Topic must stay audit-events.
AUDIT_OUTBOX_ENABLED=true
AUDIT_KAFKA_TOPIC=audit-events
AUDIT_OUTBOX_BATCH_SIZE=100
AUDIT_OUTBOX_POLL_INTERVAL=2
AUDIT_OUTBOX_MAX_RETRIES=10
AUDIT_OUTBOX_RETRY_BASE_DELAY=1
AUDIT_OUTBOX_PUBLISH_TIMEOUT=10
AUDIT_OUTBOX_SHUTDOWN_TIMEOUT=10
# Seconds to keep published outbox rows. 0 leaves cleanup disabled.
AUDIT_OUTBOX_RETENTION_SECONDS=0

# Legal entity lookup (backend-only). Never expose DADATA_API_KEY to the frontend.
LEGAL_ENTITY_LOOKUP_PROVIDER=fake
DADATA_API_KEY=
DADATA_HOST=suggestions.dadata.ru
DADATA_API_PREFIX=/suggestions/api/4_1/rs
